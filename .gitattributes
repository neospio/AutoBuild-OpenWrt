# Cross-platform: normalize text to LF in the repo on all OSes.
* text=auto eol=lf

# Windows scripts that must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never alter line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.7z binary
*.pdf binary
